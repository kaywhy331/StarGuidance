# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development
ENABLE_VISUAL_PREVIEW=false
# Safe-beta kill switch. Keep false until Stripe test-mode fulfillment, durable
# report jobs, report history, and PDF parity have passed their launch gates.
ENABLE_PROFILE_REPORTS=false
RUNTIME_ADAPTER=local
ALLOW_LOCAL_RUNTIME_ADAPTER=true
# Reading policy. Defaults preserve the PRD's one-follow-up MVP and add a
# 30-minute normalized same-question cooldown. Use bounded integers only.
READING_FOLLOW_UP_LIMIT=1
READING_REREAD_COOLDOWN_MINUTES=30
# `unlimited` preserves the MVP default. `free-window` enforces the bounded
# allowance below using durable reading history.
READING_ACCESS_MODE=unlimited
READING_FREE_ALLOWANCE=3
READING_ALLOWANCE_WINDOW_HOURS=24
# Locked sessions older than this become expired instead of resuming forever.
READING_SESSION_TTL_MINUTES=120

# Sensitive-field encryption (32-byte base64 key; generate locally, never commit it)
DATA_ENCRYPTION_KEY=
# Optional comma-separated rollback keys during a bounded rotation window.
DATA_ENCRYPTION_KEYS_PREVIOUS=
# Preferred server-only canonical base64 for exactly 32 random bytes. Required
# locally; Netlify deploys may use the code-gated, domain-separated derivation
# documented in DEPLOYMENT when this dedicated key is absent.
GUEST_TRIAL_SECRET=

# Supabase Auth and Postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; required for signup consent receipts, account deletion, and
# disposable Auth test-user cleanup.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only direct/pooler connection; must support SET LOCAL ROLE starguidance_app.
DATABASE_URL=
# Disposable/integration target only; never point this at production.
DATABASE_INTEGRATION_URL=

# Deep web-readiness authentication. This must be distinct from both the
# profile-engine and interpretation-worker secrets.
READINESS_PROBE_SECRET=

# Durable background interpretation and paid-report jobs (docs/KNOWN-GAPS.md). Authenticates
# the Netlify-scheduled trigger (netlify/functions/process-interpretation-jobs.mts)
# to POST /api/internal/interpretation-jobs, which drains both queues. Secret. Set it in the protected
# environment or the host's settings — never in this file, and never in any
# file inside the repository. Required in the "supabase" runtime adapter only.
INTERPRETATION_WORKER_SECRET=
# Optional HTTPS receiver for closed, aggregate operational alerts. The
# payload contains only an alert class, severity, observed count, threshold,
# and environment. Keep blank locally. This does not replace provider-native
# billing limits or database/hosting uptime alerts.
OPERATIONAL_ALERT_WEBHOOK_URL=
# Bounded hourly live-generation count used as a provider-cost proxy.
OPERATIONAL_LIVE_AI_VOLUME_ALERT_THRESHOLD=500

# Optional off-Netlify edge-authenticated client-IP header. The named header
# must be overwritten by the trusted edge; x-forwarded-for is never accepted.
# Supported: cf-connecting-ip, fly-client-ip, fastly-client-ip, true-client-ip, x-real-ip.
TRUSTED_CLIENT_IP_HEADER=

# Profile engine
PROFILE_ENGINE_URL=http://127.0.0.1:8000
PROFILE_ENGINE_SHARED_SECRET=
# Guarded placeholders only. Setting any of these true makes the profile engine fail
# closed until a real adapter and its licensing/reference approvals are shipped.
ENABLE_WESTERN_ASTROLOGY=false
ENABLE_BAZI=false
ENABLE_PLANETARY_ANGULARITY=false

# Provider-agnostic AI adapter (fallback is used when disabled or unconfigured)
# Live interpretation provider. Absent, or AI_PROVIDER=disabled, keeps the
# deterministic reader: a missing key degrades the reading rather than breaking
# the product. This is the staging kill switch.
AI_PROVIDER=disabled
# Live synthesis stays disabled unless its guarded-prompt and output-safety
# evaluation has been explicitly approved for the configured model.
AI_SAFETY_EVALUATION_APPROVED=false
# Secret. Set it in the protected environment or the host's settings — never in
# this file, and never in any file inside the repository. Direct Groq mode uses
# this key. Access-gateway mode requires it to be absent.
AI_PROVIDER_API_KEY=
# The reviewed chain tries strict-schema GPT-OSS 120B, validated JSON-mode
# Llama 3.3 70B, then strict-schema GPT-OSS 20B. Empty fallback configuration
# intentionally disables model fallback. The deterministic reader remains the
# final provider-independent fallback.
AI_PROVIDER_MODEL=openai/gpt-oss-120b
AI_PROVIDER_FALLBACK_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b
# Optional reviewed allowlist for runtime model drafts. When blank, the
# configured primary/fallback chain is the allowlist.
AI_PROVIDER_ALLOWED_MODELS=
# Direct is the default and current staging route. TokenPak mode remains
# deterministic unless the separately approved gateway configuration is complete.
AI_PROVIDER_TRANSPORT=direct
AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
# Custom gateway mode is a separately approved path. Its URL must be an HTTPS
# hostname ending in exactly /v1. The gateway bearer and Cloudflare Access
# identity are three distinct managed secrets; never reuse the Groq credential.
# Keep every field below blank/false for direct Groq. See
# docs/AI-GATEWAY-SECURITY.md before enabling any of them.
AI_PROVIDER_GATEWAY_APPROVED=false
AI_PROVIDER_GATEWAY_HOST=
AI_PROVIDER_GATEWAY_KEY=
AI_PROVIDER_CF_ACCESS_CLIENT_ID=
AI_PROVIDER_CF_ACCESS_CLIENT_SECRET=
AI_PROVIDER_TIMEOUT_MS=15000
AI_PROVIDER_TOTAL_TIMEOUT_MS=40000
AI_PROVIDER_MAX_OUTPUT_TOKENS=2600

# Stripe test mode. Local fulfillment is accepted only with the explicitly
# authorized, non-hosted local runtime adapter; hosted and invalid selections
# fail closed. Live secrets/events remain rejected pending separate approval.
PAYMENTS_PROVIDER=local
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROFILE_REPORT_PRICE_ID=

# Guarded operator scripts. Inventory is the safe default; destructive modes
# additionally require their exact confirmation literals (docs/OPERATIONS.md).
KEY_ROTATION_MODE=inventory
KEY_ROTATION_CONFIRM=
KEY_ROTATION_SYNTHETIC_ONLY=false
KEY_ROTATION_REQUIRE_ROWS=false
KEY_ROTATION_REQUIRE_CHANGES=false
RETENTION_MODE=inventory
RETENTION_DELETE_CONFIRM=
RETENTION_POLICY_VERSION=
RETENTION_AUDIT_BEFORE=
RETENTION_WEBHOOK_BEFORE=
RETENTION_FAILED_JOBS_BEFORE=

# Server-only UUID allowlists for the minimized operations console. Operators
# inherit support visibility and may retry retained failed jobs. Never expose
# these lists through NEXT_PUBLIC_* variables.
SUPPORT_USER_IDS=
OPERATOR_USER_IDS=
