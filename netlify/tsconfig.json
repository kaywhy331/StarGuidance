{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // process-interpretation-jobs.test.ts imports the function's .mts file by
    // its literal source extension (the noEmit + Bundler resolution this
    // package inherits doesn't do Node's usual .mts-source -> .mjs-specifier
    // remapping); this is the standard opt-in for that under `tsc --noEmit`.
    "allowImportingTsExtensions": true
  },
  "include": ["functions/**/*.mts", "functions-tests/**/*.test.ts"]
}
